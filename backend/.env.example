# Finetern Backend Environment Configuration Template
PORT=5000
NODE_ENV=development

# MySQL Database Configuration (Laragon Default)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=finetern_db
DB_PORT=3306

# JSON Web Token Secret
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
JWT_EXPIRES_IN=7d

# Google Gemini Generative AI SDK
# Dapatkan API key di: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: folder MySQL client untuk backup dan migrasi lokal
# MYSQL_BIN_DIR=C:/laragon/bin/mysql/mysql-8.4.3-winx64/bin
