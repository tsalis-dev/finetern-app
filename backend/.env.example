# Finetern Backend Environment Configuration Template
PORT=5000
NODE_ENV=development

# MySQL Database Configuration (Laragon Default)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=finetern_db
DB_PORT=3306

# JSON Web Token Secret
JWT_SECRET=finetern_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Google Gemini Generative AI SDK
# Dapatkan API key di: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
